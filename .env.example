# Токен от @BotFather
BOT_TOKEN=
# ID клан-чата (для групп он отрицательный, например -1001234567890)
CLAN_CHAT_ID=
TZ=Europe/Moscow
DB_PATH=data/bot.db

# Напоминалки про Гидру и Химеру
REMINDERS_ENABLED=true

# Шутки: сколько раз в день (случайно в этих границах) и в каком окне часов
JOKES_PER_DAY_MIN=2
JOKES_PER_DAY_MAX=3
JOKE_HOUR_FROM=12
JOKE_HOUR_TO=22
# Вероятность, что шутка будет адресной, с тегом участника
JOKE_MENTION_CHANCE=0.3

# Собеседник на Gemini (aistudio.google.com → Get API key). Пусто — выключен.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
AI_PER_USER_DAY=15
AI_PER_CHAT_DAY=200
